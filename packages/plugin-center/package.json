{
  "name": "@snapmarketing/dsh-plugin-center",
  "version": "0.1.1",
  "description": "DeepSeek Harness Snap Plugin Marketing: discover, install, and manage allowlisted plugins",
  "type": "module",
  "license": "Apache-2.0",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./typert": { "types": "./lib/types/typert.d.ts", "default": "./lib/typert.js" },
    "./remote": { "types": "./lib/types/remote.d.ts", "default": "./lib/remote.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "registry/plugins.json"
  ],
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.dts.json",
    "test": "vitest run"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0",
    "@deepseek-ai/cordis-plugin-loader": ">=1.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.0.1-rc.1",
    "@deepseek-ai/dsh-typert-protocol": ">=0.1.0-rc.5",
    "react": ">=18.2.0"
  },
  "dependencies": {
    "@snapmarketing/plugin-manifest": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "react": "^18.3.1",
    "tsdown": "0.22.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
