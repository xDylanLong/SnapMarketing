{
  "name": "dsh-snapmarketing",
  "private": true,
  "version": "0.1.0",
  "description": "dsh-snapmarketing is a thin DeepSeek Harness surface for discovering, installing, and managing allowlisted plugins",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xDylanLong/dsh-snapmarketing.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dsh:add": "node scripts/dsh-plugin.mjs add",
    "dsh:remove": "node scripts/dsh-plugin.mjs remove",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "registry:collect:source": "node scripts/collect-topic-manifest.mjs",
    "registry:classify": "node scripts/classify-marketing-plugins.mjs",
    "registry:marketing": "node scripts/build-marketing-manifest.mjs",
    "registry:validate": "node scripts/validate-catalog-update.mjs",
    "registry:collect": "pnpm registry:collect:source && pnpm registry:classify && pnpm registry:marketing && pnpm registry:validate"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zod": "^4.4.3"
  }
}
