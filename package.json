{
  "name": "snapmarketing",
  "private": true,
  "version": "0.1.0",
  "description": "Thin DeepSeek Harness Snap Plugin Marketing surface for discovery, installation, and management",
  "type": "module",
  "packageManager": "pnpm@10.4.1",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xDylanLong/SnapMarketing.git"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r build",
    "lint": "tsc -p tsconfig.json --noEmit",
    "check:package": "node scripts/check-package.mjs",
    "registry:collect": "node scripts/collect-topic-manifest.mjs && node scripts/build-marketing-manifest.mjs",
    "registry:marketing": "node scripts/build-marketing-manifest.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^26.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5",
    "zod": "^4.4.3"
  }
}
